      mesh.castShadow = castShadow;
      mesh.receiveShadow = receiveShadow;
      parent.add(mesh);
      return mesh;
    }

    // Builds a wall segment with optional window opening or doorway opening
    // Runs along X (if dir === 'x') or along Z (if dir === 'z')
    function buildWallWithOpenings(parent, {
      dir = 'x',
      fixedCoord,
      start,
      end,
      baseY = 0,
      height = 2.45,
      thickness = 0.18,
      mat = MAT.intWall,
      openings = [] // [{ from, to, bottom, top, type: 'door'|'window'|'open' }]
    }) {
      const sorted = [...openings].sort((a, b) => a.from - b.from);
      let cursor = start;

      const placeSegment = (segFrom, segTo, segBottom, segTop) => {
        const len = segTo - segFrom;
        const segH = segTop - segBottom;
        if (len <= 0.01 || segH <= 0.01) return;
        const mid = (segFrom + segTo) / 2;
        const midY = baseY + segBottom + segH / 2;
        if (dir === 'x') {
          addBox(parent, len, segH, thickness, mid, midY, fixedCoord, mat);
          // Dark architectural cutaway top cap
          if (Math.abs(segTop - height) < 0.02) {
            addBox(parent, len, 0.03, thickness + 0.005, mid, baseY + height + 0.015, fixedCoord, MAT.cutCap, false, false);
          }
        } else {
          addBox(parent, thickness, segH, len, fixedCoord, midY, mid, mat);
          if (Math.abs(segTop - height) < 0.02) {
            addBox(parent, thickness + 0.005, 0.03, len, fixedCoord, baseY + height + 0.015, mid, MAT.cutCap, false, false);
          }
        }
      };

      for (const op of sorted) {
        if (op.from > cursor) {
          placeSegment(cursor, op.from, 0, height);
        }
        // Sill below opening
        if (op.bottom > 0) {
          placeSegment(op.from, op.to, 0, op.bottom);
        }
        // Header above opening (keep low or open for cutaway visibility)
        if (op.top < height) {
          placeSegment(op.from, op.to, op.top, height);
        }
        // Render glass & frame if window
        if (op.type === 'window') {
          const wLen = op.to - op.from;
          const wH = op.top - op.bottom;
          const wMid = (op.from + op.to) / 2;
          const wMidY = baseY + op.bottom + wH / 2;
          if (dir === 'x') {
            addBox(parent, wLen, wH, 0.03, wMid, wMidY, fixedCoord, MAT.glass, false, false);
            addBox(parent, wLen, 0.05, thickness + 0.03, wMid, baseY + op.bottom + 0.025, fixedCoord, MAT.windowFrame);
            addBox(parent, 0.05, wH, thickness + 0.02, op.from + 0.025, wMidY, fixedCoord, MAT.windowFrame);
            addBox(parent, 0.05, wH, thickness + 0.02, op.to - 0.025, wMidY, fixedCoord, MAT.windowFrame);
          } else {
            addBox(parent, 0.03, wH, wLen, fixedCoord, wMidY, wMid, MAT.glass, false, false);
            addBox(parent, thickness + 0.03, 0.05, wLen, fixedCoord, baseY + op.bottom + 0.025, wMid, MAT.windowFrame);
            addBox(parent, thickness + 0.02, wH, 0.05, fixedCoord, wMidY, op.from + 0.025, MAT.windowFrame);
            addBox(parent, thickness + 0.02, wH, 0.05, fixedCoord, wMidY, op.to - 0.025, MAT.windowFrame);
          }
        }
        cursor = op.to;
      }
      if (cursor < end) {
        placeSegment(cursor, end, 0, height);
      }
    }

