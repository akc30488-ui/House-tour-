    const tempVec = new THREE.Vector3();

    function updateLabels() {
      const w = window.innerWidth;
      const h = window.innerHeight;

      Object.values(labelElements).forEach(item => {
        const floorIsShown =
          (item.floor === 'ground' && groundGroup.visible && currentFloorMode !== 'all') ||
          (item.floor === 'ground' && currentFloorMode === 'all') ||
          (item.floor === 'first' && firstFloorVisible);

        if (!labelsVisible || !floorIsShown) {
          item.el.style.opacity = '0';
          item.el.style.pointerEvents = 'none';
          return;
        }

        // In "All Floors" mode, slightly fade ground labels so upper labels stay super crisp
        const baseOpacity = (currentFloorMode === 'all' && item.floor === 'ground') ? '0.62' : '1';

        tempVec.copy(item.pos);
        if (item.floor === 'first') tempVec.y += firstGroup.position.y;
        tempVec.project(camera);

        if (tempVec.z > 1) {
          item.el.style.opacity = '0';
          item.el.style.pointerEvents = 'none';
        } else {
          const sx = (tempVec.x * 0.5 + 0.5) * w;
          const sy = (-(tempVec.y * 0.5) + 0.5) * h;
          item.el.style.left = `${sx}px`;
          item.el.style.top = `${sy}px`;
          item.el.style.opacity = baseOpacity;
          item.el.style.pointerEvents = 'auto';
        }
      });
    }

    function animate() {
      requestAnimationFrame(animate);

      // Smooth Camera Flight
      if (camAnimating) {
        camera.position.lerp(targetCamPos, 0.065);
        controls.target.lerp(targetLookAt, 0.065);
        if (camera.position.distanceTo(targetCamPos) < 0.04 && controls.target.distanceTo(targetLookAt) < 0.04) {
          camAnimating = false;
        }
      }

      // Smooth First Floor Lift / Hide Animation
      firstGroup.position.y += (firstFloorTargetY - firstGroup.position.y) * 0.12;
      if (!firstFloorVisible && Math.abs(firstGroup.position.y - firstFloorTargetY) < 0.15) {
        firstGroup.visible = false;
      }

      controls.update();
      updateLabels();
      renderer.render(scene, camera);
    }

    window.onload = function () {
      // Collapse sidebar automatically on very small screens so 3D view shines first
      if (window.innerWidth < 640) {
        toggleSidebarMobile();
      }
      selectTourStopById('overview');
      animate();
    };
  </script>
</body>
