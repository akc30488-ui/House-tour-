    function createOakFloorTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#d4b38c';
      ctx.fillRect(0, 0, 512, 512);

      const plankH = 32;
      for (let y = 0; y < 512; y += plankH) {
        const shade = (Math.random() - 0.5) * 16;
        ctx.fillStyle = `rgb(${210 + shade}, ${176 + shade * 0.8}, ${136 + shade * 0.6})`;
        ctx.fillRect(0, y, 512, plankH - 1.5);
        // Subtle wood grain lines
        ctx.strokeStyle = 'rgba(135, 98, 60, 0.14)';
        ctx.lineWidth = 1;
        for (let g = 0; g < 4; g++) {
          ctx.beginPath();
          ctx.moveTo(0, y + 5 + g * 6);
          ctx.lineTo(512, y + 6 + g * 6);
          ctx.stroke();
        }
        // Plank joint
        const jointX = ((y / plankH) * 173) % 512;
        ctx.fillStyle = 'rgba(110, 78, 48, 0.35)';
        ctx.fillRect(jointX, y, 2, plankH);
      }
      const tex = new THREE.CanvasTexture(canvas);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(6, 4.5);
      return tex;
    }

    function createTileTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#e5e7eb';
      ctx.fillRect(0, 0, 256, 256);
      ctx.strokeStyle = '#cbd5e1';
      ctx.lineWidth = 2;
      for (let i = 0; i <= 256; i += 64) {
        ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 256); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(256, i); ctx.stroke();
      }
      const tex = new THREE.CanvasTexture(canvas);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(3, 3);
      return tex;
    }

